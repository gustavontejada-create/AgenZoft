# Zoft API — variables de entorno (copiar a .env o cargarlas en Coolify)

# Proveedor de IA y modelo (Gemini gratuito más reciente al 2026-10-04; ver DEC-140)
ZOFT_PROVEEDOR=gemini
ZOFT_MODELO=gemini-3.8-flash
GEMINI_API_KEY=

# Orígenes que pueden usar el chat (separados por coma)
ZOFT_ORIGENES=https://agenzoft.com,https://www.agenzoft.com

# Precios: la misma fuente que muestra la web (si no responde, usa conocimiento/precios.json)
ZOFT_PRECIOS_URL=https://agenzoft.com/data/precios.json

# Límites para proteger el cupo gratuito
ZOFT_POR_MINUTO=8
ZOFT_POR_DIA=60
ZOFT_TOPE_DIARIO=1500

# Para ver las preguntas que Zoft no supo responder: GET /sin-respuesta?token=...
ZOFT_ADMIN_TOKEN=
ZOFT_REGISTRO_DIR=/app/registro
PORT=8787
